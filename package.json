{
  "name": "china-stocks-daily-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "cf:d1:create:stocks": "wrangler d1 create china-stocks-daily --config apps/api/wrangler.toml",
    "cf:d1:create:crypto": "wrangler d1 create crypto-daily --config apps/api/wrangler.toml",
    "db:sync:local": "node scripts/sync-d1-to-local.mjs",
    "db:sync:local:stocks": "node scripts/sync-d1-to-local.mjs stocks --yes",
    "db:sync:local:crypto": "node scripts/sync-d1-to-local.mjs crypto --yes",
    "dev": "pnpm -r --parallel --filter @china-stocks/api --filter @china-stocks/web dev",
    "dev:all": "pnpm run dev",
    "dev:api": "wrangler dev --config apps/api/wrangler.toml",
    "dev:web": "node scripts/select-web-config.mjs local && pnpm --filter @china-stocks/web dev",
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "test": "node --experimental-strip-types --experimental-specifier-resolution=node --test tests/contracts.market.test.ts tests/api.indices.test.ts tests/api.scheduler-status.test.ts tests/api.routes.test.ts tests/web.market-loaders.test.ts tests/web.status-loaders.test.ts tests/web.api-targets.test.ts",
    "check:api": "pnpm --filter @china-stocks/api check",
    "check:web": "node scripts/select-web-config.mjs remote && pnpm --filter @china-stocks/web check",
    "deploy:api": "wrangler deploy --config apps/api/wrangler.toml",
    "deploy:web": "node scripts/select-web-config.mjs remote && pnpm --filter @china-stocks/web run deploy",
    "db:generate": "pnpm --filter @china-stocks/api db:generate",
    "db:studio": "pnpm --filter @china-stocks/api db:studio"
  },
  "devDependencies": {
    "@mozilla/readability": "0.6.0",
    "linkedom": "0.18.12",
    "playwright": "1.53.2",
    "wrangler": "^4.73.0"
  }
}
