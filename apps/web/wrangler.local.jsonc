{
  "name": "china-stocks-daily-web",
  "main": "worker/index.ts",
  "assets": {
    "directory": "dist/client"
  },
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    {
      "binding": "MARKETS_API",
      "service": "china-stocks-daily-worker"
    }
  ],
  "vars": {
    "APP_ENV": "local",
    "MARKETS_API_BASE_URL": "http://127.0.0.1:8787"
  }
}
