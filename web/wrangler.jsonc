{
  "name": "crypto-daily-web",
  "main": "worker/index.ts",
  "assets": {
    "directory": "dist/client"
  },
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "crypto.bhwa233.com",
      "custom_domain": true,
      "zone_name": "bhwa233.com"
    }
  ],
  "services": [
    {
      "binding": "CRYPTO_API",
      "service": "crypto-daily-worker"
    }
  ],
  "vars": {
    "CRYPTO_API_BASE_URL": "https://crypto-api.bhwa233.com"
  }
}
